# Database Configuration
# For PostgreSQL (recommended):
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/khetsetu

# For SQLite (development):
# DATABASE_URL=sqlite:///./khetsetu.db

# FastAPI Settings
DEBUG=true

# Authentication / JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Government of India Data.gov.in Mandi API (Resource ID: 9ef84268-d588-465a-a308-a864a43d0070)
DATA_GOV_IN_API_KEY=
MANDI_PRICE_SYNC_INTERVAL_HOURS=24
MANDI_PRICE_STALE_AFTER_HOURS=48
FARMER_MAX_MARKUP_PERCENT=100

